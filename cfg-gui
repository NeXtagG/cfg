# ── модель ──────────────────────────────────────────────────────────────────

class ConfigFile(GObject.Object):
    def __init__(self, path, writable):
        super().__init__()
        self.path = path
        self.writable = writable
        self.name = os.path.basename(path)
        d = os.path.dirname(path)
        self.dir = "~" + d[len(HOME):] if d == HOME or d.startswith(HOME + "/") else d
        self.is_user = path.startswith(HOME + "/")
        self.haystack = (self.dir + "/" + self.name).lower()
        self.name_l = self.name.lower()
        base = self.name.lstrip(".")
        self.ext = base.rsplit(".", 1)[1].lower() if "." in base else ""


def load_recent():
    try:
        with open(RECENT_FILE) as f:
            return [p for p in json.load(f) if isinstance(p, str)]
    except (OSError, ValueError):
        return []


def save_recent(items):
    try:
        os.makedirs(STATE_DIR, exist_ok=True)
        with open(RECENT_FILE, "w") as f:
            json.dump(items[:RECENT_MAX], f, indent=1)
    except OSError:
        pass


def human_size(n):
    for unit in ("Б", "КБ", "МБ"):
        if n < 1024 or unit == "МБ":
            return f"{n:.0f} {unit}" if unit == "Б" else f"{n:.1f} {unit}"
        n /= 1024


def owner_of(st):
    try:
        u = pwd.getpwuid(st.st_uid).pw_name
    except KeyError:
        u = str(st.st_uid)
    try:
        g = grp.getgrgid(st.st_gid).gr_name
    except KeyError:
        g = str(st.st_gid)
    return f"{u}:{g}"


