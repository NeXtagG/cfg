    # ── фильтрация ──
    def _filter_func(self, cfg, *_):
        if self.scope == "user" and not cfg.is_user:
            return False
        if self.scope == "system" and cfg.is_user:
            return False
        if self.scope == "recent" and cfg.path not in self.recent_rank:
            return False
        return all(t in cfg.haystack for t in self.query_tokens)

    def _score(self, cfg):
        if self.scope == "recent" and not self.query_tokens:
            return (self.recent_rank.get(cfg.path, 999),)
        q = self.query_tokens[-1] if self.query_tokens else ""
        if q:
            if cfg.name_l == q or cfg.name_l.split(".")[0] == q:
                s = 0
            elif cfg.name_l.startswith(q):
                s = 1
            elif q in cfg.name_l:
                s = 2
            else:
                s = 3
        else:
            s = 0
        return (s, not cfg.is_user, cfg.haystack.count("/"), cfg.haystack)

    def _sort_func(self, a, b, *_):
        sa, sb = self._score(a), self._score(b)
        return Gtk.Ordering.SMALLER if sa < sb else Gtk.Ordering.LARGER if sa > sb else Gtk.Ordering.EQUAL

    def _refilter(self):
        self.filter.changed(Gtk.FilterChange.DIFFERENT)
        self.sorter.changed(Gtk.SorterChange.DIFFERENT)
        if self.selection.get_n_items():
            self.selection.set_selected(0)
            self.listview.scroll_to(0, Gtk.ListScrollFlags.NONE, None)

    def _on_search(self, entry):
        self.query_tokens = entry.get_text().lower().split()
        self._refilter()

    def _on_scope(self, group, _pspec):
        self.scope = group.get_active_name()
        self._refilter()

    def _on_search_key(self, _ctl, keyval, _code, state):
        n = self.selection.get_n_items()
        if not n:
            return False
        pos = self.selection.get_selected()
        step = {Gdk.KEY_Down: 1, Gdk.KEY_Up: -1, Gdk.KEY_Page_Down: 10, Gdk.KEY_Page_Up: -10}.get(keyval)
        if step is None:
            return False
        pos = max(0, min(n - 1, (0 if pos == Gtk.INVALID_LIST_POSITION else pos) + step))
        self.selection.set_selected(pos)
        self.listview.scroll_to(pos, Gtk.ListScrollFlags.NONE, None)
        return True

    def _update_count(self):
        if self.list_stack.get_visible_child_name() == "loading":
            return
        n = self.filtered.get_n_items()
        total = self.store.get_n_items()
        self.sidebar_title.set_subtitle(f"{n} из {total}" if n != total else f"{total} файлов")
        self.list_stack.set_visible_child_name("list" if n else "empty")

    # ── сканирование ──
    def rescan(self, *_):
        self.list_stack.set_visible_child_name("loading")
        self.sidebar_title.set_subtitle("сканирую…")
        try:
            proc = Gio.Subprocess.new([CFG, "--list", "all"], Gio.SubprocessFlags.STDOUT_PIPE)
        except GLib.Error as e:
            self.toast(f"Не удалось запустить cfg: {e.message}")
            return
        proc.communicate_utf8_async(None, None, self._on_scanned)

    def _on_scanned(self, proc, res):
        try:
            _ok, out, _err = proc.communicate_utf8_finish(res)
        except GLib.Error as e:
            self.toast(f"Ошибка сканирования: {e.message}")
            out = ""
        prev = self.current.path if self.current else None
        items = []
        for line in (out or "").splitlines():
            parts = line.split("\t")
            if len(parts) >= 2:
                items.append(ConfigFile(parts[0], parts[1] == "W"))
        self.store.splice(0, self.store.get_n_items(), items)
        self.list_stack.set_visible_child_name("list")
        self._refilter()
        self._update_count()
        if prev:
            self._select_path(prev)

    def _select_path(self, path):
        for i in range(self.selection.get_n_items()):
            if self.selection.get_item(i).path == path:
                self.selection.set_selected(i)
                self.listview.scroll_to(i, Gtk.ListScrollFlags.NONE, None)
                return

