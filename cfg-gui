    def _on_selected(self, *_):
        if self.editing:
            return
        item = self.selection.get_selected_item()
        self.current = item
        self.show_file(item)

    def show_file(self, cfg):
        has = cfg is not None
        for name in ("edit", "edit-sudo", "copy-path", "open-folder"):
            self.lookup_action(name).set_enabled(has)
        if not has:
            self.content_title.set_title("Конфиги")
            self.content_title.set_subtitle("")
            self.stack.set_visible_child_name("none")
            return
        self.content_title.set_title(cfg.name)
        self.content_title.set_subtitle(cfg.dir)
        try:
            st = os.stat(cfg.path)
        except OSError:
            st = None
        cfg.writable = os.access(cfg.path, os.W_OK)
        self._fill_meta(cfg, st)

        if not os.access(cfg.path, os.R_OK):
            self.stack.set_visible_child_name("locked")
            return
        try:
            with open(cfg.path, "rb") as f:
                raw = f.read(PREVIEW_LIMIT)
        except OSError as e:
            self.locked_page.set_description(str(e))
            self.stack.set_visible_child_name("locked")
            return
        if b"\0" in raw[:4096]:
            self.stack.set_visible_child_name("binary")
            return
        self._set_preview(raw.decode("utf-8", errors="replace"))
        self.stack.set_visible_child_name("preview")

    def _fill_meta(self, cfg, st):
        while (child := self.meta.get_first_child()) is not None:
            self.meta.remove(child)

        def chip(text, cls=None):
            lbl = Gtk.Label(label=text)
            lbl.add_css_class("meta-chip")
            if cls:
                lbl.add_css_class(cls)
            self.meta.append(lbl)

        if cfg.writable:
            chip("✎ можно редактировать")
        else:
            chip("🔒 нужен sudo", "root")
        if st:
            chip(owner_of(st))
            chip(stat.filemode(st.st_mode))
            chip(human_size(st.st_size))
            chip("изменён " + time.strftime("%d.%m.%Y %H:%M", time.localtime(st.st_mtime)))

    COMMENT_RE = re.compile(r"^\s*(#|//|--|;|!|\")")
    SECTION_RE = re.compile(r"^\s*\[[^\]]+\]\s*$")
    KEY_RE = re.compile(r"^(\s*)([A-Za-z_][\w.\-@$]*|\"[^\"]+\")(\s*)(=|:)")
    STRING_RE = re.compile(r"\"[^\"\n]*\"|'[^'\n]*'")

    def _set_preview(self, text):
        buf = self.buffer
        buf.set_text(text)
        if len(text) > 200_000:
            return
        for lineno, line in enumerate(text.split("\n")):
            if not line.strip():
                continue
            if self.COMMENT_RE.match(line):
                self._tag("comment", lineno, 0, len(line))
                continue
            if self.SECTION_RE.match(line):
                self._tag("section", lineno, 0, len(line))
                continue
            m = self.KEY_RE.match(line)
            if m:
                self._tag("key", lineno, m.start(2), m.end(2))
            for s in self.STRING_RE.finditer(line):
                self._tag("string", lineno, s.start(), s.end())

    def _tag(self, name, line, start, end):
        a = self.buffer.get_iter_at_line_offset(line, start)[1]
        b = self.buffer.get_iter_at_line_offset(line, end)[1]
        self.buffer.apply_tag_by_name(name, a, b)

    def _on_active_changed(self, *_):
        if self.is_active() and not self.editing and self.current:
            self.show_file(self.current)

    # ── редактирование ──
    def open_current(self, sudo=False):
        cfg = self.current
        if cfg is None or self.editing:
            return
        need_sudo = sudo or not os.access(cfg.path, os.W_OK)
        argv = ["sudo", "nano", "--", cfg.path] if need_sudo else ["nano", "--", cfg.path]
        self._remember(cfg.path)

        if self.terminal is not None:
            self.editing = True
            self.listview.set_sensitive(False)
            self.search.set_sensitive(False)
            self.terminal.reset(True, True)
            self.stack.set_visible_child_name("terminal")
            self.split.set_show_content(True)
            self.terminal.spawn_async(Vte.PtyFlags.DEFAULT, os.path.dirname(cfg.path), argv, None,
                                      GLib.SpawnFlags.SEARCH_PATH, None, None, -1, None,
                                      self._on_spawned, None)
            self.terminal.grab_focus()
        else:
            self._spawn_external(argv)

    def _on_spawned(self, _term, _pid, error, *_):
        if error is not None:
            self.toast(f"Не удалось запустить nano: {error.message}")
            self._on_editor_exited()

    def _on_editor_exited(self, *_):
        self.editing = False
        self.listview.set_sensitive(True)
        self.search.set_sensitive(True)
        self.show_file(self.current)
        self.listview.grab_focus()

    def _spawn_external(self, argv):
        for launcher in (["xdg-terminal-exec"], ["alacritty", "-e"], ["foot"], ["kitty"], ["xterm", "-e"]):
            if shutil.which(launcher[0]):
                try:
                    proc = Gio.Subprocess.new(launcher + argv, Gio.SubprocessFlags.NONE)
                except GLib.Error as e:
                    self.toast(f"Ошибка запуска терминала: {e.message}")
                    return
                proc.wait_async(None, lambda *_: self.current and self.show_file(self.current))
                return
        self.toast("Не найден эмулятор терминала")

    def _remember(self, path):
        self.recent = [path] + [p for p in self.recent if p != path]
        self.recent = self.recent[:RECENT_MAX]
        self.recent_rank = {p: i for i, p in enumerate(self.recent)}
        save_recent(self.recent)

    # ── действия ──
    def _install_actions(self):
        def add(name, cb, accels=()):
            act = Gio.SimpleAction.new(name, None)
            act.connect("activate", lambda *_: cb())
            self.add_action(act)
            if accels:
                self.get_application().set_accels_for_action(f"win.{name}", list(accels))

        add("edit", lambda: self.open_current(), ["<Ctrl>e"])
        add("edit-sudo", lambda: self.open_current(sudo=True), ["<Ctrl><Shift>e"])
        add("copy-path", self.copy_path, ["<Ctrl><Shift>c"])
        add("open-folder", self.open_folder)
        add("rescan", self.rescan, ["<Ctrl>r"])
        add("focus-search", self.focus_search, ["<Ctrl>f", "<Ctrl>k"])
        add("shortcuts", self.show_shortcuts, ["<Ctrl>question"])
        add("scope-all", lambda: self.scope_group.set_active_name("all"), ["<Alt>1"])
        add("scope-user", lambda: self.scope_group.set_active_name("user"), ["<Alt>2"])
        add("scope-system", lambda: self.scope_group.set_active_name("system"), ["<Alt>3"])
        add("scope-recent", lambda: self.scope_group.set_active_name("recent"), ["<Alt>4"])

    def focus_search(self):
        if not self.editing:
            self.split.set_show_content(False)
            self.search.grab_focus()
            self.search.select_region(0, -1)

    def copy_path(self):
        if self.current:
            self.get_display().get_clipboard().set(self.current.path)
            self.toast("Путь скопирован")

    def open_folder(self):
        if self.current:
            uri = Gio.File.new_for_path(os.path.dirname(self.current.path)).get_uri()
            Gio.AppInfo.launch_default_for_uri_async(uri, None, None, None, None)

    def show_shortcuts(self):
        rows = [
            ("Печатай где угодно", "поиск"), ("↑ ↓  PgUp PgDn", "выбор в списке"),
            ("Enter / Ctrl+E", "открыть в nano"), ("Ctrl+Shift+E", "открыть через sudo nano"),
            ("Ctrl+F", "к поиску"), ("Alt+1…4", "Все / Мои / /etc / Недавние"),
            ("Ctrl+Shift+C", "скопировать путь"), ("Ctrl+R", "пересканировать"),
        ]
        group = Adw.PreferencesGroup()
        for keys, what in rows:
            row = Adw.ActionRow(title=what)
            row.add_suffix(Gtk.Label(label=keys, css_classes=["dimmed", "monospace"]))
            group.add(row)
        page = Adw.PreferencesPage()
        page.add(group)
        dialog = Adw.Dialog(title="Горячие клавиши", content_width=440, content_height=520)
        tv = Adw.ToolbarView(content=page)
        tv.add_top_bar(Adw.HeaderBar())
        dialog.set_child(tv)
        dialog.present(self)

    def toast(self, text):
        self.toasts.add_toast(Adw.Toast(title=text, timeout=2))


class App(Adw.Application):
    def __init__(self):
        super().__init__(application_id=APP_ID, flags=Gio.ApplicationFlags.HANDLES_COMMAND_LINE)
        self.initial_query = ""

    def do_startup(self):
        Adw.Application.do_startup(self)
        provider = Gtk.CssProvider()
        provider.load_from_string(CSS)
        Gtk.StyleContext.add_provider_for_display(Gdk.Display.get_default(), provider,
                                                  Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
        quit_act = Gio.SimpleAction.new("quit", None)
        quit_act.connect("activate", lambda *_: self.quit())
        self.add_action(quit_act)
        self.set_accels_for_action("app.quit", ["<Ctrl>q"])

    def do_command_line(self, cmdline):
        query = " ".join(cmdline.get_arguments()[1:])
        win = self.get_active_window() or Window(self)
        if query:
            win.search.set_text(query)
            win.search.set_position(-1)
        win.present()
        return 0


if __name__ == "__main__":
    sys.exit(App().run(sys.argv))
